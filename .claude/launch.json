{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "node-build",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".output/server/index.mjs"
      ],
      "port": 3000
    },
    {
      "name": "stack",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-stack.mjs",
        "--gateway-port",
        "8090"
      ],
      "port": 8081
    }
  ]
}
