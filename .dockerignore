# Build context for any container image built from the repository root.
#
# The production API image (infrastructure/docker/api.Dockerfile, built by Render
# from render.yaml) needs the repository root as its context, because
# services/go.mod replaces the platform module with a relative path
# (../packages/go/platform). This file keeps node_modules, build output and
# secrets out of that context.
#
# Everything below is either unrelated to a Go build or must never enter an image.

.git
.github
.vercel
.wrangler
node_modules
.output
dist
coverage

# Secrets and local configuration: an image must never carry them.
.env
.env.*
!.env.example

# Web app and the assets it builds from, plus material the Go images do not use.
src
public
docs
supabase
tests
scripts
packages/api-contracts
*.log
