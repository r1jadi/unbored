{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "tanstack-start"
    },
    "auth": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "cmd/server/main.go"
    },
    "users": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "cmd/api/main.go"
    },
    "games": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "main.go"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/game-digests",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/v1/cron/feedback-emails",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:section(games|play|leaderboards)/queens",
      "destination": "/:section/crowns",
      "permanent": true
    },
    {
      "source": "/:section(games|play|leaderboards)/zip",
      "destination": "/:section/trail",
      "permanent": true
    },
    {
      "source": "/:section(games|play|leaderboards)/tango",
      "destination": "/:section/sun-and-moon",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(assets/.*|favicon\\.png|favicon\\.svg|apple-touch-icon\\.png|icon-.*\\.png|manifest\\.webmanifest|offline-manifest\\.json|sw\\.js|robots\\.txt|sitemap\\.xml|\\.well-known/security\\.txt)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://unbored.lol"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/auth",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/api/v1/auth/(.*)",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/api/v1/users",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/v1/users/(.*)",
      "destination": {
        "service": "users"
      }
    },
    {
      "source": "/api/v1",
      "destination": {
        "service": "games"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "games"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "games"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "games"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
