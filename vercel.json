{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "tanstack-start-lovable"
    },
    "api": {
      "root": "./",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "bindings": [
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "UPSTREAM_AUTH_URL"
        },
        {
          "type": "service",
          "service": "users",
          "format": "url",
          "env": "UPSTREAM_USERS_URL"
        },
        {
          "type": "service",
          "service": "games",
          "format": "url",
          "env": "UPSTREAM_GAMES_URL"
        }
      ]
    },
    "auth": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "cmd/server/main.go"
    },
    "users": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "cmd/api/main.go"
    },
    "games": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "main.go"
    }
  },
  "redirects": [
    {
      "source": "/:section(games|play|leaderboards)/queens",
      "destination": "/:section/crowns",
      "permanent": true
    },
    {
      "source": "/:section(games|play|leaderboards)/zip",
      "destination": "/:section/trail",
      "permanent": true
    },
    {
      "source": "/:section(games|play|leaderboards)/tango",
      "destination": "/:section/sun-and-moon",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(assets/.*|favicon\\.png|favicon\\.svg|apple-touch-icon\\.png|icon-.*\\.png|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "https://unbored.lol" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
