# Vercel container image for the API gateway (services/gateway/cmd/gateway).
#
# Why a container at all: the gateway declares a service binding to the Auth
# service, and Vercel service bindings are not available to a service on the Go
# runtime — the bindings documentation says to build such a service as a container
# image instead. The gateway therefore keeps this image; the Auth service stays on
# the Go runtime. See docs/deployment/vercel.md.
#
# The file name is fixed: Vercel only auto-detects `Dockerfile.vercel` (or
# `Containerfile.vercel`) at the service root, and an explicitly named entrypoint
# file was not detected in testing.
#
# Build context: the repository root. A container service's build context is its
# service root, and this service's root is "./" because services/go.mod replaces
# the platform module with a relative path (../packages/go/platform): the image has
# to carry both modules, so the context has to be the whole repository.
#
# The build is a plain `go build` of the gateway's own command, so the runtime
# behaviour is identical to the Go-preset deployment this replaced: same wiring,
# same PORT handling, same routes. It is not `services/cmd/api` because that slot
# belongs to the Users service — Vercel's Go preset requires one of three fixed
# entrypoint names and a container build has no such requirement.
FROM golang:1.27-bookworm AS build

WORKDIR /src

# Sources only. .dockerignore keeps node_modules, .git and build output out of the
# context, so this layer stays small and cached across web-only changes.
COPY go.work go.work
COPY packages/go/platform ./packages/go/platform
COPY services ./services

# CGO is off so the binary is fully static and can run in an empty filesystem.
# -trimpath and -s -w keep the image small and avoid embedding build paths.
WORKDIR /src/services
# The gateway builds from its own command, not from services/cmd/api: that slot
# belongs to the Users service, because Vercel's Go preset needs it and the
# gateway (a container) does not. Both files run the same
# `servicekit.MustRun(gateway.Options())`.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags "-s -w" -o /out/gateway ./gateway/cmd/gateway

# An empty filesystem with one static binary: no shell, no package manager, no
# userland to abuse. The CA bundle is copied in because the gateway verifies
# tokens against Supabase's HTTPS JWKS endpoint and calls the Auth service over
# the binding.
FROM scratch

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/gateway /gateway

# Vercel routes container traffic to port 80 unless the project sets PORT.
# config.Load prefers HTTP_ADDR, then PORT_HTTP, then PORT, so declaring PORT here
# keeps the app and Vercel's router in agreement without a project-wide variable
# (which the web service would read too).
ENV PORT=80
EXPOSE 80

# Run as an unprivileged user, not root. A scratch image has no /etc/passwd, so
# the user is numeric: 65532 is the conventional "nonroot" id (distroless uses
# the same). The binary and the CA bundle are world-readable, and the gateway
# writes nothing to disk. Binding port 80 without root relies on the runtime
# allowing unprivileged low ports, which Docker does by default
# (net.ipv4.ip_unprivileged_port_start=0 in the container's namespace). If a
# deployment ever fails to bind, set the project's PORT to 8080 rather than
# dropping this line.
USER 65532:65532

ENTRYPOINT ["/gateway"]
